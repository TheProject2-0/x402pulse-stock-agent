# Copy this file to .env and fill in ONE way to pay for data.

# Option A: pay per call with USDC on Base (x402). Use a small, separate wallet that holds a few dollars of USDC.
# Never put your main wallet's key here.
PRIVATE_KEY=

# Option B: an x402Pulse Pro key (https://www.x402pulse.dev/pro). Unlimited calls, no wallet needed.
PRO_KEY=

# Only for agent.ts: your Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Safety limits for pay-per-call (USD). The run stops before spending more than this.
MAX_SPEND_USD=0.25
MAX_PRICE_USD=0.06
